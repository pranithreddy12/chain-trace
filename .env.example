# ChainTrace Environment Configuration
# Copy this file to .env and fill in your API keys

# Etherscan API V2 (Ethereum + any EVM chain on a paid plan)
# Get your key from https://etherscan.io/apis
ETHERSCAN_API_KEY=

# BscScan API V1 (BNB Chain) — only needed because the Etherscan V2 free tier
# excludes BSC. Get a free key from https://bscscan.com/apis
BSCSCAN_API_KEY=

# TronGrid API (Tron/USDT-TRC20)
# Get your key from https://www.trongrid.io/
TRONGRID_API_KEY=

# Application Settings
DEFAULT_TRACE_DEPTH=4
MAX_BRANCHES=25
MIXER_SCORE_CAP=0.40
HOP_VELOCITY_THRESHOLD_SECONDS=300
MICRO_FANOUT_THRESHOLD=10
SUPPORTED_CHAINS=ethereum,bsc,tron
TRACE_TIME_BUDGET_SECONDS=120

# Database
DATABASE_PATH=./data/chain_trace.db

# Label Data Paths
LABELS_DIR=./data/labels
SANCTIONS_DIR=./data/sanctions
ENTITIES_DIR=./data/entities
SYNTHETIC_DIR=./data/synthetic